rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: 본인만 읽기/쓰기
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Active session: 인증된 사용자 누구나 읽기 (관리자만 쓰기)
    match /activeSession/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // 관리자 콘솔에서만
    }

    // Exams: 인증된 사용자 읽기
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Questions: 인증된 사용자 읽기
    match /questions/{qId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Results: 본인 결과만 쓰기/읽기
    match /results/{resultId} {
      allow write: if request.auth != null && resource == null;
      allow read:  if request.auth != null;
    }

    // Sessions/participants: 본인 참가 기록
    match /sessions/{examId}/participants/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
